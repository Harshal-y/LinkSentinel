# Copy this file to .env for local development.
# Never commit .env or share its contents.
SECRET_KEY=replace-with-a-long-random-secret
# Supabase PostgreSQL Session Pooler URI (recommended for hosted IPv4 runtimes)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL=
# Optional URLhaus Auth-Key. Leave blank to disable threat-intelligence lookups.
URLHAUS_AUTH_KEY=
# Used only when DATABASE_URL is blank (local SQLite mode).
DATABASE_PATH=linksentinel.db
COOKIE_SECURE=0
SCAN_TIMEOUT=5
